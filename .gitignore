# ── 虚拟环境：绝对不要提交（里面是几百个依赖包）──
.venv/
venv/
env/

# ── Python 编译产物 ──
__pycache__/
*.py[cod]
*$py.class
*.egg-info/

# ── 测试产物 ──
.pytest_cache/
allure-results/
allure-report/
test-results/

# ── 登录态 / 凭证：不能进代码库 ──
auth.json
*storage_state*.json

# ── IDE ──
.idea/
.vscode/

# ── 临时文件 ──
*.log
_*.txt
_timing.txt
_run.txt
_probe*
_practice*
